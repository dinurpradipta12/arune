{
  "name": "carousel",
  "private": true,
  "version": "1.0.2",
  "description": "Arune Editorial Studio - Standalone Desktop Edition",
  "author": "Dinur Pradipta",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:all": "vite build && electron-builder -mw"
  },
  "build": {
    "appId": "com.arune.editorialstudio",
    "productName": "Arune Editorial Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.dmg",
      "!dist/**/*.zip",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.15.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
